# Copy this file to .release.env. The real file is ignored by Git.

# RAM credentials used only by the local release uploader.
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_BUCKET=juyouapi
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Optional. Defaults are derived from the bucket/endpoint and paths below.
# Set OSS_PUBLIC_BASE_URL when using a CDN or custom domain.
OSS_PUBLIC_BASE_URL=https://juyouapi.oss-cn-hangzhou.aliyuncs.com
OSS_RELEASE_PREFIX=juyou-switcher/releases

# Tauri updater signing key. Keep the private key outside this repository.
# Defaults to ~/.tauri/juyou-switcher.key when omitted.
TAURI_SIGNING_PRIVATE_KEY_PATH=/Users/your-name/.tauri/juyou-switcher.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Optional macOS Developer ID signing and notarization.
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Optional local Linux builder image name.
LINUX_BUILDER_IMAGE=juyou-switcher-linux-builder:local
